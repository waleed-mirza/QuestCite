# === QuestCite .gitignore ===
# Private working notes stay out of the public repository.
# The release audit still rejects them if they are force-added.
/memory/
/trustops-10-week-production-plan.md
/assets/sales/

# Dependencies
node_modules/
.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Production builds
dist/
build/

# Environment — real credentials are NEVER committed (plan §14/§22)
.env
.env.*
!.env.example
!.env.test

# Test artifacts
coverage/
*.lcov
playwright-report/
test-results/
.vitest-cache/
# NOTE: supabase/tests + tests/fixtures ARE committed; only generated reports are ignored

# Supabase local dev
supabase/.branches/
supabase/.temp/

# Vercel
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
*.pem

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Local Netlify folder
.netlify
