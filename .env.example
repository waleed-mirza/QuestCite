# QuestCite — environment template (plan §14)
# Copy to .env.local for local development. The linked Supabase project is also
# the production promotion target; never commit real credentials.
# Validate any time with: pnpm check-env

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=QuestCite
APP_ENV=development

# Supabase browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never reference from a Client Component
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STORE_RESPONSES=false
AI_ENABLED=true
AI_MAX_INPUT_TOKENS_PER_RUN=
AI_MAX_OUTPUT_TOKENS_PER_RUN=

# Resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_DELIVERY_MODE=log

# Optional workspace subscriptions for a self-hosted copy.
# Leave these unset unless this deployment sells Starter/Pro/Agency plans to its
# own customers. See docs/billing.md.
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# LEMON_SQUEEZY_STARTER_VARIANT_ID=
# LEMON_SQUEEZY_PRO_VARIANT_ID=
# LEMON_SQUEEZY_AGENCY_VARIANT_ID=
# false = live in-app payments once the keys above are set. Use true while testing.
LEMON_SQUEEZY_TEST_MODE=false

# Demo protection (plan §15) — DEMO_MODE=true is the shipped default for the
# public demo; production customer deployments must turn it off.
DEMO_MODE=true
DEMO_ORG_SLUG=northstar-cloud
LIVE_DEMO_AI_ENABLED=false
DEMO_AI_GLOBAL_DAILY_LIMIT=20
DEMO_AI_USER_DAILY_LIMIT=1
DEMO_AI_MAX_QUESTIONS=5
DEMO_UPLOADS_ENABLED=false
DEMO_EMAILS_ENABLED=false

# Platform administration
PLATFORM_ADMIN_EMAILS=
# Min 32 characters, required in production. Generate: openssl rand -hex 32
AUDIT_HASH_SALT=
