{
  "name": "questcite-starter",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/waleed-mirza/QuestCite.git"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check-env && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check-env": "tsx scripts/check-env.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test --project=e2e",
    "test:a11y": "pnpm build && playwright test --project=a11y",
    "test:visual": "pnpm build && playwright test --project=visual-desktop --project=visual-mobile",
    "test:matrix": "pnpm build && playwright test --project=w10-chrome --project=w10-edge --project=w10-firefox --project=w10-mobile",
    "test:ai:offline": "vitest run tests/unit/services/w5-evaluation.test.ts tests/unit/services/drafting.test.ts tests/unit/services/answer-run.test.ts tests/unit/services/answer-run-gateway.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "db:types": "pnpm dlx supabase@2.116.0 gen types typescript --linked --schema public > src/types/database.types.ts",
    "db:migrate:remote": "pnpm dlx supabase@2.116.0 db push",
    "billing:webhook-fixture": "tsx scripts/generate-billing-webhook.ts",
    "demo:assets": "tsx scripts/generate-demo-assets.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:verify": "tsx scripts/verify-demo.ts",
    "sales:screenshots": "tsx scripts/capture-sales-screenshots.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "release:package": "tsx scripts/package-release.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "audit:release": "tsx scripts/release-audit.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.38.0",
    "mammoth": "^1.12.2",
    "next": "16.3.3",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/env": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
